#!/usr/bin/env python3

import gi
gi.require_version('Gtk', '4.0')
gi.require_version('Adw', '1')
from gi.repository import Gtk, Adw, GLib, Gio, GdkPixbuf, Gdk
import subprocess
import os
import threading
from pathlib import Path
import tempfile

class WallpaperChanger(Adw.Application):
    def __init__(self):
        super().__init__(application_id='com.example.wallpaperchanger')
        self.window = None
        self.current_file = None
        
    def do_activate(self):
        if not self.window:
            self.window = WallpaperWindow(application=self)
        self.window.present()

class WallpaperWindow(Adw.ApplicationWindow):
    def __init__(self, **kwargs):
        super().__init__(**kwargs)
        
        # Window setup
        self.set_title("Wallpaper Changer")
        self.set_decorated(False)

        self.set_resizable(False)
        self.set_default_size(600, 400)
        
        main_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        main_box.set_margin_top(12)
        main_box.set_margin_bottom(12)
        main_box.set_margin_start(12)
        main_box.set_margin_end(12)
        
        header_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
        header_box.set_halign(Gtk.Align.CENTER)
        
        title_label = Gtk.Label(label="<big><b>chbg-gui: <i>Where all your wallpaper needs are met.</i></b></big>")
        title_label.set_use_markup(True)
        header_box.append(title_label)
        
        main_box.append(header_box)
        
        file_group = Adw.PreferencesGroup()
        file_group.set_title("Select Wallpaper")
        file_group.set_description("Choose an image file (JPEG, PNG, WebP, or GIF)")
        
        self.file_row = Adw.ActionRow()
        self.file_row.set_title("Image File")
        self.file_row.set_subtitle("No file selected")
        
        self.file_button = Gtk.Button(label="Choose File...")
        self.file_button.connect('clicked', self.on_file_choose_clicked)
        self.file_button.set_valign(Gtk.Align.CENTER)
        self.file_row.add_suffix(self.file_button)
        
        file_group.add(self.file_row)
        main_box.append(file_group)
        
        preview_group = Adw.PreferencesGroup()
        preview_group.set_title("Preview")
        
        self.preview_frame = Gtk.Frame()
        self.preview_frame.set_size_request(400, 300)
        self.preview_frame.set_halign(Gtk.Align.CENTER)
        
        self.preview_image = Gtk.Picture()
        self.preview_image.set_can_shrink(True)
        self.preview_image.set_content_fit(Gtk.ContentFit.CONTAIN)
        self.preview_frame.set_child(self.preview_image)
        
        placeholder = Gtk.Label(label="No image selected")
        placeholder.add_css_class("dim-label")
        self.preview_image.set_alternative_text("Image preview")
        self.preview_frame.set_child(placeholder)
        self.placeholder = placeholder
        
        preview_group.add(self.preview_frame)
        main_box.append(preview_group)
        
        button_group = Adw.PreferencesGroup()
        
        button_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
        button_box.set_halign(Gtk.Align.CENTER)
        button_box.set_homogeneous(True)
        
        self.apply_button = Gtk.Button(label="Set as Wallpaper")
        self.apply_button.add_css_class("suggested-action")
        self.apply_button.connect('clicked', self.on_apply_clicked)
        self.apply_button.set_sensitive(False)
        button_box.append(self.apply_button)
        
        button_group.add(button_box)
        main_box.append(button_group)
        
        self.progress_bar = Gtk.ProgressBar()
        self.progress_bar.set_visible(False)
        main_box.append(self.progress_bar)
        
        self.set_content(main_box)
        
    def on_file_choose_clicked(self, button):
        dialog = Gtk.FileDialog()
        dialog.set_title("Select Wallpaper Image")
        
        image_filter = Gtk.FileFilter()
        image_filter.set_name("Image Files")
        image_filter.add_mime_type("image/jpeg")
        image_filter.add_mime_type("image/png") 
        image_filter.add_mime_type("image/webp")
        image_filter.add_mime_type("image/gif")
        
        all_filter = Gtk.FileFilter()
        all_filter.set_name("All Files")
        all_filter.add_pattern("*")
        
        filter_list = Gio.ListStore()
        filter_list.append(image_filter)
        filter_list.append(all_filter)
        
        dialog.set_filters(filter_list)
        dialog.set_default_filter(image_filter)
        
        dialog.open(self, None, self.on_file_selected)
        
    def on_file_selected(self, dialog, result):
        try:
            file = dialog.open_finish(result)
            if file:
                file_path = file.get_path()
                self.set_selected_file(file_path)
        except Exception as e:
            self.show_error(f"Error selecting file: {str(e)}")
            
    def set_selected_file(self, file_path):
        self.current_file = file_path
        self.file_row.set_subtitle(os.path.basename(file_path))
        self.apply_button.set_sensitive(True)
        
        self.load_preview(file_path)
        
    def load_preview(self, file_path):
        try:
            if file_path.lower().endswith('.gif'):
                with tempfile.NamedTemporaryFile(suffix='.png', delete=False) as tmp:
                    cmd = ['ffmpeg', '-i', file_path, '-vf', 'select=eq(n\\,0)', '-vframes', '1', tmp.name, '-y']
                    result = subprocess.run(cmd, capture_output=True, text=True)
                    if result.returncode == 0:
                        file_to_load = tmp.name
                    else:
                        file_to_load = file_path
            else:
                file_to_load = file_path
                
            pixbuf = GdkPixbuf.Pixbuf.new_from_file_at_scale(
                file_to_load, 400, 300, True
            )
            texture = Gdk.Texture.new_for_pixbuf(pixbuf)
            self.preview_image.set_paintable(texture)
            
            self.preview_frame.set_child(self.preview_image)
            
            if file_path.lower().endswith('.gif') and file_to_load != file_path:
                try:
                    os.unlink(file_to_load)
                except:
                    pass
                    
        except Exception as e:
            print(f"Error loading preview: {e}")
            
    def on_apply_clicked(self, button):
        if not self.current_file:
            return
            
        self.progress_bar.set_visible(True)
        self.apply_button.set_sensitive(False)
        
        # Start progress pulse
        self.progress_bar.pulse()
        self.pulse_timeout = GLib.timeout_add(100, self.pulse_progress)
        
        thread = threading.Thread(target=self.run_wallpaper_script)
        thread.daemon = True
        thread.start()
        
    def pulse_progress(self):
        self.progress_bar.pulse()
        return True 
        
    def run_wallpaper_script(self):
        try:
        
            script_abs = os.path.join(os.environ.get('HOME'), '.local/bin/chbg')        
            script_dir = os.path.dirname(os.path.abspath(__file__))
            script_path = os.path.join(script_dir, script_abs)
            
            if not os.path.exists(script_path):
                script_path = "./chbg" 
            
            result = subprocess.run(
                [script_path, self.current_file],
                capture_output=True,
                text=True,
                timeout=60
            )
            
            if result.returncode == 0:
                GLib.idle_add(self.on_script_success, result.stdout)
            else:
                GLib.idle_add(self.on_script_error, result.stderr)
                
        except subprocess.TimeoutExpired:
            GLib.idle_add(self.on_script_error, "Script timed out")
        except Exception as e:
            GLib.idle_add(self.on_script_error, str(e))
            
    def on_script_success(self, output):
        self.cleanup_progress()
        self.get_application().quit()
    
    def on_script_error(self, error):
        self.cleanup_progress()
        self.show_error(f"Failed to set wallpaper:\n{error}")
        
    def cleanup_progress(self):
        if hasattr(self, 'pulse_timeout'):
            GLib.source_remove(self.pulse_timeout)
        self.progress_bar.set_visible(False)
        self.apply_button.set_sensitive(True)
        
    def show_error(self, message):
        dialog = Adw.MessageDialog.new(self, "Error", message)
        dialog.add_response("ok", "OK")
        dialog.show()

def main():
    app = WallpaperChanger()
    return app.run()

if __name__ == '__main__':
    main()
