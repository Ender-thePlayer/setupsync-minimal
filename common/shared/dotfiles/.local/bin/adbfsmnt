#!/usr/bin/env bash
set -e

MOUNTPOINT="$HOME/Phone"
prebackup=false
postbackup=false
        
case $1 in
mount)
    prebackup=true
    ;;
umount)
    postbackup=true
    ;;
help)
    echo -e "Usage:\n\n  mount - mount the phone\n  umount - umount the phone"
    ;;
*)
    exit 1
    ;;
esac

if $prebackup; then
	mkdir -p "$MOUNTPOINT"
	adb wait-for-device
	
	if ! mountpoint -q "$MOUNTPOINT"; then
	    echo "Mounting phone..."
	    adbfs -o modules=subdir -o subdir=/sdcard/ "$MOUNTPOINT"
	    echo "Phone mounted at $MOUNTPOINT"
	fi
	
elif $postbackup; then
	echo "Unmounting phone..."
	fusermount -uz "$MOUNTPOINT"
	rm -r "$MOUNTPOINT"
	echo "Phone unmounted"
fi
