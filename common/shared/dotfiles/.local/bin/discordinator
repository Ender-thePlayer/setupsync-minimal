#!/usr/bin/env bash

get_extension() {
    f="${1##*/}"
    case "$f" in
    .*) get_extension "${f#.}" && return 0 ;;
    esac
    case "$f" in
    .*.*) echo "${f#.}" ;;
    *.*) echo "${f#*.}" ;;
    *) return 0 ;;
    esac
}

get_filepath_without_extension() {
    ext=$(get_extension "$1")
    echo "${1%."$ext"}"
}

print_usage() {
    echo "Usage: discordinator <input_file> {-c1 | -c2} {-s}"
    echo "    -c1: High compression (smaller size, slower)"
    echo "    -c2: Lower compression (faster, larger size using VA-API)"
    echo "    -s: Upload it to Streamable and get the link"
}

input_file="$1"
compression_level="$2"
upload_to_streamable="$3"
upload=false
gif_file=false
use_vaapi=false

if [ ! -f "$input_file" ]; then
    echo "ERROR: input file '$input_file' does not exist"
    exit 1
fi

input_file_ext="$(get_extension "$input_file")"
output_file="$(get_filepath_without_extension "$input_file")_compressed.$input_file_ext"

vcodec="libx264"
acodec="copy"
format_opt=""

case $input_file_ext in
mp4|mov)
    vcodec="libx264"
    acodec="aac"
    ;;
webm)
    vcodec="libvpx-vp9"
    acodec="libopus"
    ;;
mkv)
    vcodec="libx265"
    acodec="libopus"
    ;;
avi|flv)
    vcodec="libx264"
    acodec="aac"
    format_opt="-f mp4"
    output_file="$(get_filepath_without_extension "$input_file")_compressed.mp4"
    ;;
gif|GIF)
    gif_file=true
    ;;
*)
    echo "WARNING: unsupported video format - trying with default codecs"
    ;;
esac

case $compression_level in
-c1)
    crf=28
    preset="veryslow"
    ;;
-c2)
    use_vaapi=true
    ;;
*)
    if ! $gif_file; then
        echo "ERROR: Invalid compression level. Use -c1 or -c2."
        print_usage
        exit 1
    fi
    ;;
esac

case $upload_to_streamable in
-s)
    upload=true
    ;;
*)
    upload=false
    ;;
esac

echo "Compressing video. This could take a while..."

if [ "$upload" = true ]; then
    random_string=$(< /dev/urandom tr -dc 'A-Za-z0-9' | head -c 16)
    output_file="$HOME/.cache/$random_string.$input_file_ext"
fi

if $gif_file; then
    ffmpeg -i "$input_file" -vf "fps=15,scale=512:-1:flags=lanczos,split[s0][s1];[s0]palettegen[p];[s1][p]paletteuse" "$output_file" && \
    gifsicle -O3 --lossy=80 "$output_file" -o "$output_file"

elif [ "$use_vaapi" = true ]; then
    if ffmpeg -hwaccel vaapi -vaapi_device /dev/dri/renderD128 -i "$input_file" -vf 'format=nv12,hwupload' -c:v h264_vaapi -b:v 7000k -c:a $acodec "$output_file"; then
        echo "Hardware-accelerated compression (VA-API) completed successfully"
    else
        echo "ERROR: VA-API compression failed"
        exit 1
    fi
else
    if [ -n "$format_opt" ]; then
        if ffmpeg -i "$input_file" -c:v $vcodec -crf $crf -preset $preset -c:a $acodec "$format_opt" "$output_file"; then
            echo "Compression completed successfully"
            echo "Output file: $output_file"
        else
            echo "ERROR: Compression failed"
            exit 1
        fi
    else
        if ffmpeg -i "$input_file" -c:v $vcodec -crf $crf -preset $preset -c:a $acodec "$output_file"; then
            echo "Compression completed successfully"
            echo "Output file: $output_file"
        else
            echo "ERROR: Compression failed"
            exit 1
        fi
    fi
fi

if [ "$upload" = true ]; then
    scaffold "$output_file"
    rm "$output_file"
fi

