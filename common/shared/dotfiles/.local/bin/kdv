#!/bin/bash

SUPPORTED_FORMATS=("mp3" "flac" "wav" "aac" "ogg" "wma" "m4a" "opus" "aiff" "ape" "ac3" "dts")
usage() {
    echo -e "\nKonvert2DS cli"
    echo "Usage: kdv [OPTIONS] <input_path>"
    echo "Convert audio files to M4A format"
    echo ""
    echo "Arguments:"
    echo "  input_path    Path to audio file or folder containing audio files"
    echo ""
    echo "Options:"
    echo "  -o OUTPUT     Specify custom output directory"
    echo "  -f            Force overwrite existing files"
    echo "  -s            Skip files that already exist (default)"
    echo "  -h            Show this help message"
    echo ""
    echo "Supported formats: ${SUPPORTED_FORMATS[*]}"
    echo ""
    echo "Examples:"
    echo "  kdv song.flac                   # Creates song_converted.m4a"
    echo "  kdv /path/to/music/             # Creates 'converted' folder in /path/to/music/"
    echo "  kdv -o /output/dir song.wav     # Creates song_converted.m4a in /output/dir"
    echo "  kdv -o /output/dir /music/      # Converts all supported audio files to /output/dir"
    echo "  kdv -f song.flac                # Force overwrite if output exists"
}

output_dir=""
input_path=""
force_overwrite=false

while [[ $# -gt 0 ]]; do
    case $1 in
        -o|--output)
            output_dir="$2"
            shift 2
            ;;
        -f|--force)
            force_overwrite=true
            shift
            ;;
        -s|--skip)
            force_overwrite=false
            shift
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        -*)
            echo "Error: Unknown option $1"
            usage
            exit 1
            ;;
        *)
            if [[ -z "$input_path" ]]; then
                input_path="$1"
            else
                echo "Error: Multiple input paths specified"
                usage
                exit 1
            fi
            shift
            ;;
    esac
done

if [[ -z "$input_path" ]]; then
    echo "Error: No input path specified"
    usage
    exit 1
fi

if [[ ! -e "$input_path" ]]; then
    echo "Error: Input path '$input_path' does not exist"
    exit 1
fi

is_supported_format() {
    local file="$1"
    local ext="${file##*.}"
    ext="${ext,,}"
    
    for format in "${SUPPORTED_FORMATS[@]}"; do
        if [[ "$ext" == "$format" ]]; then
            return 0
        fi
    done
    return 1
}

get_extension() {
    local file="$1"
    local ext="${file##*.}"
    echo "${ext}" | tr '[:upper:]' '[:lower:]'
}

get_filename_without_ext() {
    local file="$1"
    local base
    base=$(basename "$file")
    echo "${base%.*}"
}

is_already_m4a() {
    local file="$1"
    local ext
    ext=$(get_extension "$file")
    [[ "$ext" == "m4a" ]]
}

convert_file() {
    local input_file="$1"
    local output_file="$2"
    local input_format
    input_format=$(get_extension "$input_file")
    
    # Check if input is already m4a
    if is_already_m4a "$input_file"; then
        echo "⚠ Skipping: $(basename "$input_file") (already M4A format)"
        return 2  # Return 2 to indicate skipped
    fi
    
    # Check if output file exists
    if [[ -f "$output_file" ]]; then
        if [[ "$force_overwrite" == false ]]; then
            echo "⚠ Skipping: $(basename "$input_file") (output already exists: $(basename "$output_file"))"
            return 2  # Return 2 to indicate skipped
        else
            echo "⚠ Overwriting existing file: $(basename "$output_file")"
        fi
    fi
    
    echo "Converting: $(basename "$input_file") [$input_format -> m4a]"
    mkdir -p "$(dirname "$output_file")"
    
    # Use -y flag to automatically overwrite if force is enabled, -n to never overwrite otherwise
    local overwrite_flag
    if [[ "$force_overwrite" == true ]]; then
        overwrite_flag="-y"
    else
        overwrite_flag="-n"
    fi
    
    if ffmpeg $overwrite_flag -i "$input_file" -map_metadata 0 -map 0:a -c:a aac -b:a 128k -c:v copy -id3v2_version 3 -metadata:s:v title="Album cover" -metadata:s:v comment="Cover (front)" -f mp4 "$output_file" 2>/dev/null; then
        echo "✓ Converted: $(basename "$input_file") -> $(basename "$output_file")"
        return 0
    else
        echo "✗ Failed to convert: $(basename "$input_file")"
        return 1
    fi
}

if [[ -f "$input_path" ]]; then
    if ! is_supported_format "$input_path"; then
        echo "Error: Input file format not supported. Supported formats: ${SUPPORTED_FORMATS[*]}"
        exit 1
    fi

    input_dir=$(dirname "$input_path")
    filename=$(get_filename_without_ext "$input_path")
    
    if [[ -n "$output_dir" ]]; then
        output_file="$output_dir/${filename}_converted.m4a"
    else
        output_file="$input_dir/${filename}_converted.m4a"
    fi

    convert_file "$input_path" "$output_file"
    exit_code=$?
    
    if [[ $exit_code -eq 2 ]]; then
        echo "File was skipped."
    fi
    
elif [[ -d "$input_path" ]]; then
    audio_files=()
    for format in "${SUPPORTED_FORMATS[@]}"; do
        for file in "$input_path"/*."$format" "$input_path"/*."${format^^}"; do
            if [[ -f "$file" ]]; then
                audio_files+=("$file")
            fi
        done
    done
    
    if [[ ${#audio_files[@]} -eq 0 ]]; then
        echo "No supported audio files found in directory: $input_path"
        echo "Supported formats: ${SUPPORTED_FORMATS[*]}"
        exit 1
    fi
    
    if [[ -n "$output_dir" ]]; then
        final_output_dir="$output_dir"
    else
        final_output_dir="$input_path/converted"
    fi
    
    mkdir -p "$final_output_dir"
    
    converted_count=0
    failed_count=0
    skipped_count=0
    
    echo "Found ${#audio_files[@]} audio files to convert..."
    echo ""
    
    for input_file in "${audio_files[@]}"; do
        filename=$(get_filename_without_ext "$input_file")
        output_file="$final_output_dir/$filename.m4a"
        
        convert_file "$input_file" "$output_file"
        exit_code=$?
        
        case $exit_code in
            0) ((converted_count++)) ;;
            1) ((failed_count++)) ;;
            2) ((skipped_count++)) ;;
        esac
    done
    
    echo ""
    echo "Conversion complete!"
    echo "Successfully converted: $converted_count files"
    if [[ $skipped_count -gt 0 ]]; then
        echo "Skipped files: $skipped_count files"
    fi
    if [[ $failed_count -gt 0 ]]; then
        echo "Failed conversions: $failed_count files"
    fi
    echo "Output directory: $final_output_dir"
    
else
    echo "Error: Input path is neither a file nor a directory"
    exit 1
fi
